# Copy this file to .env for local Compose only. Never commit .env.
APP_ENV=production
LOG_LEVEL=INFO
MAX_BATCH_ITEMS=250
MAX_REQUEST_BYTES=262144
STALE_AFTER_HOURS=36
MCP_MAX_REQUEST_BYTES=524288

POSTGRES_DB=budget_tracker
POSTGRES_USER=budget_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://budget_app:replace-with-a-long-random-password@db:5432/budget_tracker

# Simple mode needs one high-entropy master key. Do not reuse a bank or OpenAI secret.
API_KEY=replace-with-one-long-random-master-key

# Set this to the public HTTPS origin to enable the ChatGPT remote MCP endpoint.
# Do not include /mcp, a trailing slash, credentials, a query, or a fragment.
PUBLIC_BASE_URL=

# Optional separate password for the private OAuth consent page. When omitted,
# the simple API_KEY is used. Advanced role-key mode must set this explicitly.
# Never expose this value to ChatGPT.
OAUTH_CONSENT_SECRET=
OAUTH_AUTHORIZATION_CODE_TTL_SECONDS=300
OAUTH_ACCESS_TOKEN_TTL_SECONDS=900
OAUTH_REFRESH_TOKEN_TTL_SECONDS=7776000

# Optional advanced role-specific keys. Every configured key must be different.
BUDGET_READ_API_KEY=
BUDGET_WRITE_API_KEY=
BUDGET_ADMIN_API_KEY=

# CORS is open by default. Set comma-separated exact origins to restrict browser access.
CORS_ALLOWED_ORIGINS=*

# The local default is loopback-only. Use an exact LAN address only when required.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8080
